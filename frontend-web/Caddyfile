# Servidor de produção do front na Railway.
# - Serve o build do Vite (/srv) com fallback para index.html (rotas do React Router)
# - Repassa /api/* para o backend pela rede privada da Railway (sem CORS)
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	handle /api/* {
		# Ex.: API_UPSTREAM=http://backend-spring.railway.internal:8080
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
