#PROFILE SPRING
SPRING_PROFILES_ACTIVE=${perfil do spring (ex: dev, test, prod)}
#CONFIG DO POSTGRES
POSTGRES_PASSWORD=${senha do banco}
POSTGRES_DB=${nome do banco}
POSTGRES_USER=${user do banco}
#CONFIG DO BACK
BACK_POSTGRES_HOSTNAME=${host do banco no backend}
BACK_POSTGRES_PORT=${porta do banco}
BACK_POSTGRES_BD=${nome do banco}
BACK_POSTGRES_PASSWORD=${senha do banco para o backend}
BACK_POSTGRES_USER=${user do banco para o backend}
#CONFIG DO CEREBRAS
CEREBRAS_API_KEY=${key da API do Cerebras}
#CONFIG DO JWT
TOKEN_SECRET=${secret do token}
TOKEN_ISSUE=${issuer do token}